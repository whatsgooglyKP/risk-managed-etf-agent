# Copy this file to .env and fill in your Alpaca keys. NEVER commit .env.
# Paper keys: https://app.alpaca.markets -> switch to "Paper Trading" -> API Keys -> Generate
ALPACA_API_KEY=your_paper_key_id_here
ALPACA_SECRET_KEY=your_paper_secret_here
# Optional: set to "live" only when you are ready (the --live CLI flag is ALSO required).
# TRADING_MODE=paper
